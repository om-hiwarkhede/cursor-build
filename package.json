{
  "name": "cursor-build",
  "version": "0.2.1",
  "description": "Swarm Rebuild-style website animations as an npm package. Wrap your app with a provider and watch a swarm of animated cursors bootstrap your interface: covers the page, then draws, types and assembles it back.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react/provider.d.ts",
      "default": "./src/react/provider.js"
    },
    "./vue": {
      "types": "./src/vue/composable.d.ts",
      "default": "./src/vue/composable.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "swarm",
    "cursor",
    "animation",
    "website-animations",
    "multiplayer-cursor",
    "figma",
    "canvas",
    "rebuild",
    "react",
    "vue",
    "provider",
    "swarm-rebuild"
  ],
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/om-hiwarkhede/cursor-build.git"
  },
  "homepage": "https://github.com/om-hiwarkhede/cursor-build#readme",
  "bugs": {
    "url": "https://github.com/om-hiwarkhede/cursor-build/issues"
  }
}
